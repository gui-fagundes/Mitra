# Copie para deploy/.env no servidor e preencha (o .env nunca vai para o git).
# Gerar segredos: ver deploy/README.md, passo 5.

# Endereço público, sem https:// (ex.: 203-0-113-10.sslip.io ou mitra.seudominio.com)
DOMINIO=

# Banco (o PostgreSQL roda no próprio servidor, no container db)
POSTGRES_PASSWORD=

# Autenticação e criptografia
TOKEN_SECRET_KEY=
TOKEN_ALGORITHM=HS256
ENCRYPTION_KEY=

# E-mail. A DigitalOcean bloqueia as portas 25/465/587: use um serviço de envio
# na porta 2525 (Brevo, Mailgun, SendGrid). O remetente precisa estar verificado nele.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mitra <remetente-verificado@seu-dominio.com>
EMAIL_SUPORTE=

# DATABASE_URL, ENV, FRONTEND_URL, CORS_ORIGINS e UPLOADS_DIR são definidos no
# docker-compose.yml a partir de DOMINIO e POSTGRES_PASSWORD.
