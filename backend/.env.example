# PostgreSQL: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# Usada pelos testes (pytest). BANCO SEPARADO — é limpo a cada teste.
TEST_DATABASE_URL=

# JWT
TOKEN_SECRET_KEY=
TOKEN_ALGORITHM=HS256

# Fernet key (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# development | production — controla Secure do cookie
ENV=development

# Origens permitidas pelo CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
