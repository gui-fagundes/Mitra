# PostgreSQL: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# Usada pelos testes (pytest). BANCO SEPARADO — é limpo a cada teste.
TEST_DATABASE_URL=

# JWT
TOKEN_SECRET_KEY=
TOKEN_ALGORITHM=HS256

# Fernet key (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# development | production — controla Secure do cookie
ENV=development

# Origens permitidas pelo CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Links enviados por e-mail (ex.: redefinição de senha) apontam para cá
FRONTEND_URL=http://localhost:5173

# E-mail transacional (aiosmtplib). Sem SMTP_HOST, os e-mails só aparecem no log.
# Porta 465 = TLS direto; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mitra <nao-responda@seu-dominio.com>
